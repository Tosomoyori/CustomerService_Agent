# ===== LLM 配置 =====
# 留空则自动进入 Mock 模式（规则路由 + 模板生成 + 抽取式回答，完全离线可跑）
# 填入后自动切换为真实调用（OpenAI 兼容接口，DeepSeek / Qwen 等均可）
APP_LLM_BASE_URL=https://api.deepseek.com/v1
APP_LLM_API_KEY=
APP_LLM_MODEL=deepseek-chat

# 强制 Mock 模式（优先于上面的自动判断）：1=强制离线演示，0=强制真实调用，留空=自动
APP_MOCK=

# ===== 服务 =====
APP_HOST=127.0.0.1
APP_PORT=8000

# ===== 检索 =====
APP_RAG_TOP_K=3
APP_RAG_MIN_SCORE=0.6
